  "scripts": {
    "build": "nest build",
    "postinstall": "prisma generate",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "prisma:push:dev": "dotenv -e .env.development -- prisma db push",
    "prisma:pull:dev": "dotenv -e .env.development -- prisma db pull",
    "prisma:generate:dev": "dotenv -e .env.development -- prisma generate",
    "prisma:migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "prisma:reset:dev": "dotenv -e .env.development -- prisma migrate reset",
    "prisma:studio:dev": "dotenv -e .env.development -- prisma studio",
    "prisma:push": "dotenv -e .env -- prisma db push",
    "prisma:pull": "dotenv -e .env -- prisma db pull",
    "prisma:generate": "dotenv -e .env -- prisma generate",
    "prisma:migrate": "dotenv -e .env -- prisma migrate dev",
    "prisma:reset": "dotenv -e .env -- prisma migrate reset",
    "prisma:studio": "dotenv -e .env -- prisma studio",
    "prisma:seed": "dotenv -e .env -- prisma db seed",
    "prisma:seed:dev": "dotenv -e .env.development -- ts-node -r tsconfig-paths/register src/prisma/seed.ts",
    "prisma:prod:migrate": "cross-env NODE_ENV=production node prisma-env.js migrate deploy",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
